sdh-shacl:sdh_C23_Shape a sh:NodeShape ;
        sh:targetClass sdh:C23 ;
        sh:name "Use";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];

        sh:property [
            sh:path sdh-short:P1 ;
            sh:name "at some time within";
            sh:datatype xsd:string;
            sh:order 5;
            ];

        sh:property [
            sh:path sdh-short:P4 ;
            sh:name "begins on";
            sh:datatype xsd:string;
            sh:order 6;
            ];

        sh:property [
            sh:path sdh-short:P7 ;
            sh:name "ends on";
            sh:datatype xsd:string;
            sh:order 7;
            ];
    
        sh:property [
            sh:path sdh:P30 ;
            sh:name "is use by" ;
            sh:class crm:E21 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh:P30 ;
            sh:name "is use by" ;
            sh:class crm:E74 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh:P31 ;
            sh:name "has purpose" ;
            sh:class crm:E89 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh:P32 ;
            sh:name "is use of" ;
            sh:class sdh:C17 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh:P29 ;
            sh:name "has use type" ;
            sh:class sdh:C24 ;
            sh:maxCount 1 ;
        ];
    .

sdh-shacl:crm_E89_Shape a sh:NodeShape ;
        sh:targetClass crm:E89 ;
        sh:name "Propositional Object";
    
