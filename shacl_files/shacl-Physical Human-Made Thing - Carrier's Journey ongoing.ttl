@prefix sdh-shacl: <https://sdhss.org/shacl/profiles/>. 
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sdh-short: <https://sdhss.org/ontology/shortcuts/>.
@prefix sdh: <https://sdhss.org/ontology/core/>.
@prefix sdh-act: <https://sdhss.org/ontology/human-activity/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.

sdh-shacl:sdh_C13_Shape a sh:NodeShape ;
        sh:targetClass sdh:C13 ;
        sh:name "Geographical Place";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];
    
    .

sdh-shacl:sdh-act_C5_Shape a sh:NodeShape ;
        sh:targetClass sdh-act:C5 ;
        sh:name "Carrier's Journey";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];

        sh:property [
            sh:path sdh-short:P1 ;
            sh:name "at some time within";
            sh:datatype xsd:string;
            sh:order 5;
            ];

        sh:property [
            sh:path sdh-short:P4 ;
            sh:name "begins on";
            sh:datatype xsd:string;
            sh:order 6;
            ];

        sh:property [
            sh:path sdh-short:P7 ;
            sh:name "ends on";
            sh:datatype xsd:string;
            sh:order 7;
            ];
    
        sh:property [
            sh:path sdh-act:P4 ;
            sh:name "is journey of" ;
            sh:class crm:E24 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh:P60 ;
            sh:name "moved from" ;
            sh:class sdh:C13 ;
        ];
    
        sh:property [
            sh:path sdh:P61 ;
            sh:name "moved to" ;
            sh:class sdh:C13 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh-act:P5 ;
            sh:name "has carrier's journey identifying type" ;
            sh:class sdh-act:C6 ;
            sh:maxCount 1 ;
        ];
    .

sdh-shacl:sdh-act_C6_Shape a sh:NodeShape ;
        sh:targetClass sdh-act:C6 ;
        sh:name "Carrier's Journey Type";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];
    
    .

sdh-shacl:crm_E24_Shape a sh:NodeShape ;
        sh:targetClass crm:E24 ;
        sh:name "Physical Human-Made Thing";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];
    
    .