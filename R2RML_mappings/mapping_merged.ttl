<#obtaining-a-study-title-1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.v_education" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://elites-suisses.lod4hss.org/resource/{id_edu}";
        # rr:termType rr:IRI;
        rr:class sdh-sls:C7;
    ];
    rr:predicateObjectMap [
        # was obtained by 
        rr:predicate sdh-sls:P9;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/p{id_person}" ];
    ];
    rr:predicateObjectMap [
        # is obtention of study title
        rr:predicate sdh-sls:P10;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/stu-tit{fk_study_title}" ];
    ];
    rr:predicateObjectMap [
        # has academic supervisor
        rr:predicate sdh-sls:P11;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/p{id_directeur}" ];
    ];
    rr:predicateObjectMap [
        # is obtention in
        rr:predicate sdh-sls:P25;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/stu-dis{fk_study_discipline}" ];
    ];
    rr:predicateObjectMap [
        # obtention date, at some time within
        rr:predicate sdh-short:P1;
        rr:objectMap [ rr:column "grade_date" ;
                rr:dataType xsd:integer];
    ];
    rr:predicateObjectMap [
        # is delivered by group
        rr:predicate sdh-sls:P17;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/g{pk_group}" ];
    ].



<#membership-1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.v_membership" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://elites-suisses.lod4hss.org/resource/memb{id}";
        # rr:termType rr:IRI;
        rr:class sdh-slc:C5;
    ];
    rr:predicateObjectMap [
        # was obtained by 
        rr:predicate sdh-slc:P1;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/p{fk_person}" ];
    ];
    rr:predicateObjectMap [
        # obtention date, at some time within
        rr:predicate sdh-short:P4;
        rr:objectMap [ rr:column "begin_year" ;
                rr:dataType xsd:integer];
    ];
    rr:predicateObjectMap [
        # obtention date, at some time within
        rr:predicate sdh-short:P7;
        rr:objectMap [ rr:column "end_year" ;
                rr:dataType xsd:integer];
    ];
    rr:predicateObjectMap [
        # is delivered by group
        rr:predicate sdh-slc:P2;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/g{fk_group}" ];
    ].