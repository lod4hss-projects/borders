<#study-title-1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.t_study_title" ];
    rr:subjectMap [
        rr:template "https://elites-suisses.lod4hss.org/resource/stu-tit{id}";
        rr:termType rr:IRI;
