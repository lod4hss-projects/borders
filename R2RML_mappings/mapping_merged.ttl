@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdh-short: <https://sdhss.org/ontology/shortcuts/>.
@prefix sdh: <https://sdhss.org/ontology/core/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.
@prefix swel: <https://elites-suisses.lod4hss.org/resource/>.
@prefix sdh-slc: <https://sdhss.org/ontology/social-life-core/>.
@prefix sdh-sls: <https://sdhss.org/ontology/social-life-specific/>.


<#identite1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.identite" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://elites-suisses.lod4hss.org/resource/p{id}";
        rr:termType rr:IRI;
        rr:class crm:E21;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name_forename" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-slc:P23;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/gen{fk_gender}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P2;
        rr:objectMap [ rr:column "birth_year" ;
                rr:dataType xsd:integer];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P13;
        rr:objectMap [ rr:column "death_year" ;
                rr:dataType xsd:integer];
    ].

<#identifier1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.v_same_as" ];
    rr:subjectMap [
        rr:template "https://elites-suisses.lod4hss.org/resource/p{\"zkf_ID_linked\"}";
        rr:termType rr:IRI;
    ];
    rr:predicateObjectMap [
        rr:predicate owl:sameAs;
        rr:objectMap [ rr:column "same_as" ;
                        rr:termType rr:IRI ];
    ]
    .

<#gender1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.t_gender" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://elites-suisses.lod4hss.org/resource/gen{pk_gender}";
        rr:termType rr:IRI;
        rr:class sdh-slc:C11;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P11;
        rr:objectMap [ rr:column "description" ];
    ];
       rr:predicateObjectMap [
        rr:predicate owl:sameAs;
        rr:objectMap [ 
            rr:column "wikidata_uri";
            rr:termType rr:IRI 
        ];
    ].



<#birth1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.v_person_birth" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://elites-suisses.lod4hss.org/resource/{id_birth}";
        rr:termType rr:IRI;
        rr:class crm:E67;
    ];
    rr:predicateObjectMap [
        rr:predicate crm:P98;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/p{child}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate crm:P96;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/p{mother}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate crm:P97;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/p{father}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P1;
        rr:objectMap [ rr:column "birth_year" ;
                rr:dataType xsd:integer];
    ];            
    rr:predicateObjectMap [
        rr:predicate sdh:P6;
        rr:objectMap [ rr:template "https://elites-suisses.lod4hss.org/resource/gp{fk_birth_place}" ];
    ].



<#soc_relation_type1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.t_social_relationship_type" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://elites-suisses.lod4hss.org/resource/srt{pk_social_relationship_type}";
        rr:class sdh-slc:C4;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P11;
        rr:objectMap [ rr:column "description" ];
    ];    
    rr:predicateObjectMap [
        rr:predicate owl:sameAs;
        rr:objectMap [ 
            rr:column "wikidata_uri";
            rr:termType rr:IRI 
        ];
    ] .


